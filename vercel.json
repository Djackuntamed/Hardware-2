{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/public/tjv-logo-new.png"
    },
    {
      "source": "/tjv-logo-new.png",
      "destination": "/public/tjv-logo-new.png"
    },
    {
      "source": "/tvj-hardware-jingle.mpeg",
      "destination": "/public/tvj-hardware-jingle.mpeg"
    },
    {
      "source": "/((?!admin\\.html|public/|images/|styles\\.css|script\\.js|admin\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
